      $('.retry',fb).onclick=()=>{ opts.forEach(x=>{x.disabled=false;x.className='opt';}); fb.className='feedback'; c.classList.remove('ok','no'); };
    });
    wrap.appendChild(c);
  });
}
function wireChoice(c,q){
  const opts=$$('.opt',c), fb=$('.feedback',c);
  opts.forEach(b=>b.onclick=()=>{
    const ok=Number(b.dataset.j)===q.correct;
    opts.forEach(x=>{ x.disabled=true; if(Number(x.dataset.j)===q.correct) x.classList.add('reveal-ok'); });
    b.classList.add(ok?'pick-ok':'pick-no'); c.classList.add(ok?'ok':'no');
    fb.className='feedback show '+(ok?'good':'bad');
    fb.innerHTML=(ok?'<b>맞아요! 🎉</b> ':'<b>다시 볼까요.</b> ')+q.explain+' <button class="retry">다시 풀기</button>';
    $('.retry',fb).onclick=()=>{ opts.forEach(x=>{x.disabled=false;x.className='opt';}); fb.className='feedback'; c.classList.remove('ok','no'); };
  });
}

